+// displaceR sample-table-cache.
+//
+// do_sample() normalises, sorts and accumulates the whole probability vector on
+// every call, then makes its draws from that table. Most calls repeat the exact
+// same inputs (a vessel's grounds or port-ground entries only change at a
+// reload or a closure). For bit-for-bit identical (val, proba) the table is
+// identical too -- std::sort is deterministic for the same input sequence and
+// the sums are done in the same order -- so a stored copy can be reused and the
+// draws from unif_rand() are unchanged. Inputs are matched by full byte
+// comparison, never by hash alone. Bounded by DISPLACE_SAMPLE_CACHE_MB
+// (default 256 per thread; 0 disables); emptied when full.
+namespace displaceR_sample {
+
+// Only picks the bucket; a hit is confirmed by memcmp below.
+inline uint64_t hash_bytes(const void *data, size_t len, uint64_t h)
+{
+    const unsigned char *p = static_cast<const unsigned char *>(data);
+    size_t i = 0;
+    for (; i + 8 <= len; i += 8) {
+        uint64_t w;
+        std::memcpy(&w, p + i, 8);
+        h = (h ^ w) * 0x9E3779B97F4A7C15ULL;
+        h ^= h >> 29;
+    }
+    for (; i < len; ++i)
+        h = (h ^ p[i]) * 1099511628211ULL;
+    return h ^ len;
+}
+
+inline size_t budget_bytes()
+{
+    static const size_t budget = [] {
+        const char *mb = std::getenv("DISPLACE_SAMPLE_CACHE_MB");
+        return static_cast<size_t>(mb ? std::strtoull(mb, nullptr, 10) : 256ULL) * 1024 * 1024;
+    }();
+    return budget;
+}
