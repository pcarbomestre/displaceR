+template <typename I>
+const std::vector<std::tuple<I, double> > &do_sample_cached_table(int nval, const std::vector<I> &val, const std::vector<double> &proba)
+{
+    using namespace displaceR_sample;
+    static thread_local std::unordered_map<uint64_t, Entry<I> > cache;
+    static thread_local size_t bytes = 0;
+
+    uint64_t key = hash_bytes(val.data(), val.size() * sizeof(I), 1469598103934665603ULL);
+    key = hash_bytes(proba.data(), proba.size() * sizeof(double), key);
+
+    auto it = cache.find(key);
+    if (it != cache.end()) {
+        const Entry<I> &e = it->second;
+        if (e.val.size() == val.size() && e.proba.size() == proba.size() &&
+            std::memcmp(e.val.data(), val.data(), val.size() * sizeof(I)) == 0 &&
+            std::memcmp(e.proba.data(), proba.data(), proba.size() * sizeof(double)) == 0)
+            return e.table;
+    }
+
+    Entry<I> e{val, proba, do_sample_table(nval, val, proba)};
+    const size_t size = val.size() * (sizeof(I) + sizeof(double) + sizeof(std::tuple<I, double>)) + 128;
+    if (it == cache.end() && bytes + size > budget_bytes()) {
+        cache.clear();
+        bytes = 0;
+    }
+    if (it == cache.end()) {
+        bytes += size;
+        it = cache.emplace(key, std::move(e)).first;
+    } else {
+        it->second = std::move(e);   // hash collision or changed inputs: replace
+    }
+    return it->second.table;
+}
