--- a/commons/Population.cpp
+++ b/commons/Population.cpp
@@ -30,6 +30,15 @@
 static std::random_device rd;
 static std::mt19937 g(rd());
 
+// displaceR reproducible-diffusion: diffuse_N_from_field() shuffles nodes with
+// g, which is seeded from std::random_device, so diffusePopN made every run
+// different even for the same simulation name. SimModel::initRandom() now
+// reseeds g with the seed taken from the name, as it already does for rand().
+void reseed_population_shuffle(unsigned int seed)
+{
+    g.seed(seed);
+}
