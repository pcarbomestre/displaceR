+// displaceR astar-speedup, compact graph.
+//
+// GeoGraph::Graph is an adjacency_list<listS, vecS, undirectedS>: every
+// out-edge is a node in a linked list pointing at a separately allocated edge
+// record, so the search spends its time chasing pointers. The copy below holds
+// the same out-edges in flat arrays, in exactly the order Boost's out_edges()
+// yields them, and searchShortestPathCompact() is a line-by-line transcription
+// of what searchShortestPath() runs: astar_search_tree() initialisation,
+// astar_search_no_init_tree() with the same 4-ary heap of (rank, vertex) pairs,
+// boost::relax() for an undirected graph (including its reverse branch),
+// closed_plus combine and std::less compare, all on the same float values. So
+// it visits the same vertices in the same order and returns the same path.
+//
+// Not used if any weight is negative (Boost would throw negative_edge there) or
+// with DISPLACE_ASTAR_COMPACT=0.
+void AStarShortestPathFinder::buildCompactGraph(const GeoGraph &ggraph)
+{
+    const auto &graph = ggraph.graph;
+    const size_t n = num_vertices(graph);
+    mOffsets.assign(n + 1, 0);
+    mTargets.clear();
+    mWeights.clear();
+    mTargets.reserve(2 * num_edges(graph));
+    mWeights.reserve(2 * num_edges(graph));
+    auto weight = get(edge_weight, graph);
+    for (size_t v = 0; v < n; ++v) {
+        mOffsets[v] = mTargets.size();
+        BGL_FORALL_OUTEDGES_T(v, e, graph, GeoGraph::Graph) {
+            const GeoGraph::cost w = get(weight, e);
+            if (w < GeoGraph::cost()) {
+                mCompactEnabled = false;
+                return;
+            }
+            mTargets.push_back(target(e, graph));
+            mWeights.push_back(w);
+        }
+    }
+    mOffsets[n] = mTargets.size();
+    mPred.resize(n);
+    mDist.resize(n);
+}
+
+std::list<types::NodeId>
+AStarShortestPathFinder::searchShortestPathCompact(const GeoGraph &ggraph, GeoGraph::vertex from, GeoGraph::vertex to)
+{
+    using Vertex = GeoGraph::vertex;
+    using Distance = GeoGraph::cost;
+    const size_t n = mOffsets.size() - 1;
+
+    const Distance inf = boost::detail::get_max<Distance>()();
+    const Distance zero = Distance();
+    std::less<Distance> compare;
+    closed_plus<Distance> combine(inf);
+    distance_heuristic<GeoGraph::Graph, Distance, GeoGraph::location const *> h(ggraph.locations.data(), to);
+
+    // astar_search_tree(): initialise every vertex, then the source.
+    for (size_t u = 0; u < n; ++u) {
+        mDist[u] = inf;
+        mPred[u] = u;
+    }
+    mDist[from] = zero;
+    const Distance source_rank = h(from);
+
+    // astar_search_no_init_tree()
+    typedef d_ary_heap_indirect< std::pair< Distance, Vertex >, 4,
+        null_property_map< std::pair< Distance, Vertex >, std::size_t >,
+        function_property_map< graph_detail::select1st< Distance, Vertex >,
+            std::pair< Distance, Vertex > >,
+        std::less< Distance > >
+        MutableQueue;
+    MutableQueue Q(make_function_property_map< std::pair< Distance, Vertex > >(
+                       graph_detail::select1st< Distance, Vertex >()),
+        null_property_map< std::pair< Distance, Vertex >, std::size_t >(),
+        compare);
+
+    bool found = false;
+    Q.push(std::make_pair(source_rank, from));
+    while (!Q.empty()) {
+        Vertex v;
+        Distance v_rank;
+        boost::tie(v_rank, v) = Q.top();
+        Q.pop();
+        if (v == to) {                       // astar_goal_visitor::examine_vertex
+            found = true;
+            break;
+        }
+        for (size_t k = mOffsets[v]; k < mOffsets[v + 1]; ++k) {
+            const Vertex w = mTargets[k];
+            const Distance e_weight = mWeights[k];
+
+            // boost::relax(e, g, ...) with u = source(e) = v, undirected.
+            bool decreased;
+            const Distance d_u = mDist[v];
+            const Distance d_v = mDist[w];
+            if (compare(combine(d_u, e_weight), d_v)) {
+                mDist[w] = combine(d_u, e_weight);
+                if (compare(mDist[w], d_v)) {
+                    mPred[w] = v;
+                    decreased = true;
+                } else {
+                    decreased = false;
+                }
+            } else if (compare(combine(d_v, e_weight), d_u)) {
+                mDist[v] = combine(d_v, e_weight);
+                if (compare(mDist[v], d_u)) {
+                    mPred[v] = w;
+                    decreased = true;
+                } else {
+                    decreased = false;
+                }
+            } else {
+                decreased = false;
+            }
+
+            if (decreased) {
+                Distance w_rank = combine(mDist[w], h(w));
+                Q.push(std::make_pair(w_rank, w));
+            }
+        }
+    }
+
+    std::list<types::NodeId> result;
+    if (!found)
+        return result;
+
+    for(auto v = to;; v = mPred[v]) {
+        result.push_front(types::NodeId(static_cast<unsigned short> (v) ));
+        if(mPred[v] == v)
+            break;
+    }
+    return result;
+}
