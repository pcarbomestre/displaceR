+// displaceR astar-speedup: what GeographicLib returns when a latitude is
+// outside [-90, 90]. GeoGraph::addNode stores {x, y} into a location declared
+// {y, x}, so the heuristic below passes each node's longitude as its latitude.
+// Wherever |longitude| > 90 (the whole US west coast, for instance) Inverse()
+// therefore returns NaN for every call, after doing the full geodesic work.
+// Returning that same NaN directly leaves the search, and so every path,
+// unchanged; it only skips the work. The value is probed from the library
+// itself at startup, and the shortcut is disabled unless the probe yields NaN
+// or if DISPLACE_ASTAR_NAN_SHORTCUT=0.
+struct NanShortcut {
+    bool enabled = false;
+    double value = 0;
+    NanShortcut() {
+        double d = 0;
+        GeographicLib::Geodesic::WGS84().Inverse(91.0, 0.0, 0.0, 0.0, d);
+        const char *env = std::getenv("DISPLACE_ASTAR_NAN_SHORTCUT");
+        enabled = std::isnan(d) && !(env && *env == '0');
+        value = d;
+    }
+};
+
+const NanShortcut &nanShortcut()
+{
+    static const NanShortcut shortcut;
+    return shortcut;
+}
