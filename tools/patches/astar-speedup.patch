-//std::list<int>
+// displaceR astar-speedup, path cache. Every caller asks for a path on the same const
+// graph, loaded once, and the search below draws no random numbers, so the same
+// (from, to) always yields the same list. Returning a stored copy is therefore
+// identical to searching again; only the time differs.
+//
+// The cache is bounded by DISPLACE_ASTAR_CACHE_MB (default 1024; 0 disables
+// it). When full it is emptied and refilled, which keeps whatever pairs the
+// current quarter's grounds use. DISPLACE_ASTAR_CACHE_STATS=1 prints the hit
+// rate to stderr every 1000 lookups.
 std::list<types::NodeId>
 AStarShortestPathFinder::findShortestPath(const GeoGraph &ggraph, GeoGraph::vertex from, GeoGraph::vertex to)
+{
+    std::lock_guard<std::mutex> lock(mCacheMutex);
+
+    if (mCacheGraph != &ggraph) {
+        mCache.clear();
+        mCacheBytes = 0;
+        mCacheGraph = &ggraph;
+        const char *mb = std::getenv("DISPLACE_ASTAR_CACHE_MB");
+        mCacheBudget = (mb ? std::strtoull(mb, nullptr, 10) : 1024ULL) * 1024ULL * 1024ULL;
+        const char *st = std::getenv("DISPLACE_ASTAR_CACHE_STATS");
+        mCacheStats = st && *st && *st != '0';
+        const char *cg = std::getenv("DISPLACE_ASTAR_COMPACT");
+        mCompactEnabled = !(cg && *cg == '0');
+        if (mCompactEnabled)
+            buildCompactGraph(ggraph);
+    }
+
+    auto search = [&]() {
+        return mCompactEnabled ? searchShortestPathCompact(ggraph, from, to)
+                               : searchShortestPath(ggraph, from, to);
+    };
+
+    if (mCacheBudget == 0)
+        return search();
+
+    const uint64_t key = (static_cast<uint64_t>(from) << 32) | static_cast<uint64_t>(to);
+    auto it = mCache.find(key);
+    std::list<types::NodeId> result;
+    if (it != mCache.end()) {
+        ++mHits;
+        result.assign(it->second.begin(), it->second.end());
+    } else {
+        ++mMisses;
+        result = search();
+        const size_t bytes = result.size() * sizeof(types::NodeId) + 64;
+        if (mCacheBytes + bytes > mCacheBudget) {
+            mCache.clear();
+            mCacheBytes = 0;
+            ++mFlushes;
+        }
+        mCache.emplace(key, std::vector<types::NodeId>(result.begin(), result.end()));
+        mCacheBytes += bytes;
+    }
+
+    if (mCacheStats && (mHits + mMisses) % 1000 == 0) {
+        std::cerr << "astar-path-cache: " << (mHits + mMisses) << " lookups, "
+                  << mHits << " hits (" << (100.0 * mHits / (mHits + mMisses)) << "%), "
+                  << mCache.size() << " paths, " << (mCacheBytes >> 20) << " MB, "
+                  << mFlushes << " flushes\n";
+    }
+    return result;
+}
