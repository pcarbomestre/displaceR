+// displaceR dd-learning: read vesselsspe_<fname>/dd_learning_params.dat into
+// Vessel::dd_learning_params. Lines "key value" (keys: dd_beta, dd_max_ratio,
+// learn_lambda, learn_alpha, learn_min_factor, learn_max_factor); no file:
+// the defaults. An unknown key or a value out of range is an error.
+void read_dd_learning_params(const std::string & fname, const std::string & folder)
+{
+    std::string filename = folder + "/vesselsspe_" + fname + "/dd_learning_params.dat";
+    Vessel::DdLearningParams p;
+    std::ifstream in(filename.c_str());
+    bool found = !in.fail();
+    if (found) {
+        std::string line;
+        int linenum = 0;
+        while (std::getline(in, line)) {
+            ++linenum;
+            size_t first = line.find_first_not_of(" \t\r");
+            if (first == std::string::npos || line[first] == '#') continue;
+            std::istringstream ss(line);
+            std::string key;
+            double val = 0.0;
+            bool ok = static_cast<bool>(ss >> key >> val) && std::isfinite(val) && val >= 0;
+            if (ok) {
+                if (key == "dd_beta") p.dd_beta = val;
+                else if (key == "dd_max_ratio") { ok = val > 0; p.dd_max_ratio = val; }
+                else if (key == "learn_lambda") p.learn_lambda = val;
+                else if (key == "learn_alpha") { ok = val > 0 && val <= 1; p.learn_alpha = val; }
+                else if (key == "learn_min_factor") { ok = val > 0; p.learn_min_factor = val; }
+                else if (key == "learn_max_factor") { ok = val > 0; p.learn_max_factor = val; }
+                else ok = false;
+            }
+            if (!ok) {
+                std::stringstream er;
+                er << "dd-learning: cannot use line " << linenum << " of " << filename
+                   << " (expected: key value; keys dd_beta, dd_max_ratio, learn_lambda, learn_alpha (0-1], learn_min_factor, learn_max_factor)";
+                throw std::runtime_error(er.str());
+            }
+        }
+        if (p.learn_min_factor > p.learn_max_factor)
+            throw std::runtime_error("dd-learning: learn_min_factor > learn_max_factor in " + filename);
+    }
+    Vessel::dd_learning_params = p;
+    cout << "dd-learning: " << (found ? "read dd_learning_params.dat" : "no dd_learning_params.dat, defaults")
+         << ": dd_beta " << p.dd_beta << " dd_max_ratio " << p.dd_max_ratio << " learn_lambda " << p.learn_lambda
+         << " learn_alpha " << p.learn_alpha << " learn_min_factor " << p.learn_min_factor
+         << " learn_max_factor " << p.learn_max_factor << "\n";
+}
