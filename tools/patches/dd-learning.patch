+// displaceR dd-learning
+Vessel::DdLearningParams Vessel::dd_learning_params;
+
+void Vessel::update_ground_learning()
+{
+    // per-trip sums of the grounds fished (cumeffort_per_trip_per_fgrounds adds
+    // the step's hours once per pop: the same scale on every node and in the
+    // vessel total, so the factor's ratio is unaffected)
+    const auto& grds = this->get_fgrounds();
+    const double a = dd_learning_params.learn_alpha;
+    size_t n = std::min(grds.size(), std::min(cumeffort_per_trip_per_fgrounds.size(), cumcatch_fgrounds.size()));
+    double C = 0.0, E = 0.0;
+    for (size_t i = 0; i < n; ++i) {
+        double e = cumeffort_per_trip_per_fgrounds.at(i);
+        if (e <= 0.0) continue;
+        double c = cumcatch_fgrounds.at(i);
+        double r = c / e;
+        int key = static_cast<int>(grds.at(i).toIndex());
+        auto it = learned_cpue_nodes.find(key);
+        if (it == learned_cpue_nodes.end()) learned_cpue_nodes[key] = r;
+        else it->second = (1.0 - a) * it->second + a * r;
+        C += c;
+        E += e;
+    }
+    if (E > 0.0) {
+        double r = C / E;
+        learned_cpue_vessel = learned_cpue_vessel < 0.0 ? r : (1.0 - a) * learned_cpue_vessel + a * r;
+    }
+}
+
+double Vessel::ground_learning_factor(types::NodeId n) const
+{
+    if (!(learned_cpue_vessel > 0.0)) return 1.0;
+    auto it = learned_cpue_nodes.find(static_cast<int>(n.toIndex()));
+    if (it == learned_cpue_nodes.end()) return 1.0;
+    const auto& p = dd_learning_params;
+    double f = std::pow(std::max(it->second / learned_cpue_vessel, 1e-12), p.learn_lambda);
+    return std::min(std::max(f, p.learn_min_factor), p.learn_max_factor);
+}
